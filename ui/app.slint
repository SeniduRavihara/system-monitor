import { Button, LineEdit, ScrollView, ListView, CheckBox, Palette } from "std-widgets.slint";
export struct ProcessRow { pid: int, name: string, parent: string, cpu: string, memory: string, download: string, upload: string, read: string, write: string, selected: bool, active: bool }
component Cell inherits Text { color: #cbd2dd; font-size: 12px; vertical-alignment: center; overflow: elide; }
component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent: #80baff;
    background: #22262e; border-radius: 8px;
    VerticalLayout { padding: 14px; spacing: 6px;
        Text { text: root.label; color: #909bad; font-size: 11px; }
        Text { text: root.value; color: root.accent; font-size: 22px; font-weight: 600; }
    }
}
export component Monitor inherits Window {
    title: "System Monitor"; preferred-width: 1240px; preferred-height: 820px; min-width: 1000px; min-height: 650px;
    background: #191c22;
    default-font-family: "DejaVu Sans"; default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in property <[ProcessRow]> rows;
    in property <string> cpu-total: "…";
    in property <string> memory-total: "…";
    in property <string> download-total: "…";
    in property <string> upload-total: "…";
    in property <string> interface-totals;
    in property <string> status: "Network monitoring is off. Enable it to see per-process traffic.";
    in property <string> summary;
    in property <string> details: "Select a process to inspect its executable and full command line.";
    in property <bool> can-end: false;
    in property <bool> network-running: false;
    in-out property <bool> confirm: false;
    in-out property <bool> force: false;
    in property <string> selected-name;
    in property <string> result;
    callback search(string);
    callback sort(int);
    callback select(int);
    callback network();
    callback end-process(bool);
    callback active-only(bool);
    VerticalLayout { padding: 22px; spacing: 14px;
        HorizontalLayout { height: 44px; spacing: 12px;
            Rectangle { width: 36px; height: 36px; background: #28415d; border-radius: 9px; Text { text: "↗"; color: #a9d4ff; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; } }
            VerticalLayout { spacing: 2px;
                Text { text: "System Monitor"; color: #f1f4fa; font-size: 21px; font-weight: 700; }
                Text { text: "Know what’s using your connection"; color: #919bad; font-size: 12px; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: root.network-running ? "Network monitoring enabled" : "Enable network monitoring"; enabled: !root.network-running; clicked => {root.network();} }
        }
        HorizontalLayout { height: 88px; spacing: 12px;
            Metric { label: "CPU • ALL CORES"; value: root.cpu-total; }
            Metric { label: "MEMORY • USED / TOTAL"; value: root.memory-total; accent: #d5c1ff; horizontal-stretch: 1.5; }
            Metric { label: "↓ DOWNLOAD • SHOWN ROWS"; value: root.download-total; accent: #73dcc4; }
            Metric { label: "↑ UPLOAD • SHOWN ROWS"; value: root.upload-total; accent: #8dbdff; }
        }
        Text { text: root.interface-totals; height: 18px; color: #929eaf; font-size: 11px; }
        Rectangle { height: 48px; background: #222b38; border-radius: 6px;
            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.status; color: #b8cce6; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
        }
        HorizontalLayout { height: 34px; spacing: 12px;
            LineEdit { placeholder-text: "Search name, PID, parent or command…"; edited(text) => {root.search(text);} horizontal-stretch: 1; }
            CheckBox { text: "Network active only"; toggled => {root.active-only(self.checked);} }
            Text { text: root.summary; color: #929eaf; vertical-alignment: center; }
        }
        Rectangle { background: #1e2229; border-radius: 6px; vertical-stretch: 1;
            VerticalLayout { padding: 1px; spacing: 0px;
                HorizontalLayout { height: 38px; padding-left: 8px; padding-right: 8px; spacing: 8px;
                    Button { text: "Process"; horizontal-stretch: 1; clicked => {root.sort(0);} }
                    Button { text: "PID"; width: 74px; clicked => {root.sort(1);} }
                    Button { text: "CPU"; width: 68px; clicked => {root.sort(2);} }
                    Button { text: "Memory"; width: 100px; clicked => {root.sort(3);} }
                    Button { text: "↓ Download"; width: 112px; clicked => {root.sort(4);} }
                    Button { text: "↑ Upload"; width: 112px; clicked => {root.sort(5);} }
                    Button { text: "Disk read"; width: 100px; clicked => {root.sort(6);} }
                    Button { text: "Disk write"; width: 100px; clicked => {root.sort(7);} }
                }
                ListView { content-width: self.visible-width;
                        for row in root.rows: Rectangle {
                            height: 38px; background: row.selected ? #293e58 : (touch.has-hover ? #282e38 : #1e2229);
                            HorizontalLayout { padding-left: 12px; padding-right: 8px; spacing: 8px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 0px; padding-top: 4px; padding-bottom: 4px;
                                    Cell { text: row.name; color: row.selected ? #ffffff : #e1e6ee; }
                                    Cell { text: row.parent; color: #7e8c9f; font-size: 10px; }
                                }
                                Cell { text: row.pid; width: 74px; }
                                Cell { text: row.cpu; width: 68px; }
                                Cell { text: row.memory; width: 100px; }
                                Cell { text: row.download; width: 112px; color: row.active ? #79e3c9 : #8996a8; }
                                Cell { text: row.upload; width: 112px; color: row.active ? #9bc7ff : #8996a8; }
                                Cell { text: row.read; width: 100px; }
                                Cell { text: row.write; width: 100px; }
                            }
                            touch := TouchArea { clicked => {root.select(row.pid);} }
                        }
                }
            }
        }
        Rectangle { height: 100px; background: #22262e; border-radius: 6px;
            ScrollView { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px;
                Text { width: parent.width; text: root.details; color: #abb8ca; font-size: 12px; wrap: word-wrap; }
            }
        }
        HorizontalLayout { height: 35px; spacing: 12px;
            Button { text: "End process…"; enabled: root.can-end; clicked => {root.force=false;root.confirm=true;} }
            Button { text: "Force quit…"; enabled: root.can-end; clicked => {root.force=true;root.confirm=true;} }
            Text { text: root.result; color: #dbbd91; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: "Updates every second"; color: #788598; vertical-alignment: center; font-size: 11px; }
        }
    }
    if root.confirm: Rectangle { background: #000000b0;
        TouchArea {}
        Rectangle { width: 480px; height: 210px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; background: #292e38; border-radius: 10px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: root.force ? "Force quit this process?" : "End this process?"; color: #ffffff; font-size: 20px; font-weight: 600; }
                Text { text: root.selected-name; color: #a8caff; overflow: elide; }
                Text { text: root.force ? "Stops immediately. Unsaved work may be lost." : "Requests the process to exit. Unsaved work may be lost."; color: #c4cbd5; wrap: word-wrap; }
                HorizontalLayout { Rectangle {} Button { text: "Cancel"; clicked => {root.confirm=false;} } Button { text: root.force ? "Force quit" : "End process"; clicked => {root.end-process(root.force);root.confirm=false;} } }
            }
        }
    }
}
